CREATE DATABASE IF NOT EXISTS ConstraintsDB;
USE ConstraintsDB;
CREATE TABLE Courses(course_id INT PRIMARY KEY,course_name VARCHAR(60) NOT NULL UNIQUE,duration_months INT CHECK(duration_months>0));
CREATE TABLE Enrollments(enrollment_id INT PRIMARY KEY,student_name VARCHAR(60) NOT NULL,course_id INT,enrollment_date DATE DEFAULT (CURRENT_DATE),status VARCHAR(20) DEFAULT 'Active',FOREIGN KEY(course_id) REFERENCES Courses(course_id));
