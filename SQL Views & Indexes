CREATE DATABASE IF NOT EXISTS ViewIndexDB;
USE ViewIndexDB;
CREATE TABLE Customers(customer_id INT PRIMARY KEY,customer_name VARCHAR(60),city VARCHAR(40),credit_limit DECIMAL(10,2));
