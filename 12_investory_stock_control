CREATE DATABASE IF NOT EXISTS InventoryDB;
USE InventoryDB;
CREATE TABLE Suppliers(supplier_id INT PRIMARY KEY,supplier_name VARCHAR(60),city VARCHAR(40));
CREATE TABLE Inventory(item_id INT PRIMARY KEY,item_name VARCHAR(60),category VARCHAR(30),quantity INT DEFAULT 0,reorder_level INT DEFAULT 10,unit_cost DECIMAL(9,2),supplier_id INT,FOREIGN KEY(supplier_id) REFERENCES Suppliers(supplier_id));
