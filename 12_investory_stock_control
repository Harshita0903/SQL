INSERT INTO Inventory VALUES (101,'Monitor','Electronics',8,10,8500,1),(102,'Mouse','Electronics',45,15,450,1),(103,'Printer Paper','Stationery',6,20,280,2),(104,'Desk Organizer','Stationery',25,8,350,2),(105,'Storage Box','Office',4,10,600,3);
SELECT i.item_name,i.quantity,i.reorder_level,s.supplier_name FROM Inventory i JOIN Suppliers s ON i.supplier_id=s.supplier_id;
SELECT * FROM Inventory WHERE quantity<=reorder_level;
SELECT category,SUM(quantity) AS units,SUM(quantity*unit_cost) AS stock_value FROM Inventory GROUP BY category;
UPDATE Inventory SET quantity=quantity+20 WHERE item_id=101;
