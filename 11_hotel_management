CREATE DATABASE IF NOT EXISTS HotelDB;
USE HotelDB;
CREATE TABLE Guests(guest_id INT PRIMARY KEY, guest_name VARCHAR(60), phone VARCHAR(15) UNIQUE);
CREATE TABLE Rooms(room_id INT PRIMARY KEY, room_type VARCHAR(30), price_per_night DECIMAL(9,2), room_status VARCHAR(20) DEFAULT 'Available');
CREATE TABLE Bookings(booking_id INT PRIMARY KEY, guest_id INT, room_id INT, check_in DATE, check_out DATE, booking_status VARCHAR(20), FOREIGN KEY(guest_id) REFERENCES Guests(guest_id), FOREIGN KEY(room_id) REFERENCES Rooms(room_id));
