SELECT b.booking_id,g.guest_name,r.room_type,r.price_per_night,b.check_in,b.check_out FROM Bookings b JOIN Guests g ON b.guest_id=g.guest_id JOIN Rooms r ON b.room_id=r.room_id;
SELECT * FROM Rooms WHERE room_status='Available';
SELECT room_type,AVG(price_per_night) AS average_price FROM Rooms GROUP BY room_type;
