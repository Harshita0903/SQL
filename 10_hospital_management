CREATE DATABASE IF NOT EXISTS HospitalDB;
USE HospitalDB;
CREATE TABLE Patients(patient_id INT PRIMARY KEY, patient_name VARCHAR(60), age INT, city VARCHAR(40));
CREATE TABLE Doctors(doctor_id INT PRIMARY KEY, doctor_name VARCHAR(60), specialization VARCHAR(50));
CREATE TABLE Appointments(appointment_id INT PRIMARY KEY, patient_id INT, doctor_id INT, appointment_date DATE, fee DECIMAL(8,2), status VARCHAR(20), FOREIGN KEY(patient_id) REFERENCES Patients(patient_id), FOREIGN KEY(doctor_id) REFERENCES Doctors(doctor_id));
