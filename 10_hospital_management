SELECT p.patient_name,d.doctor_name,d.specialization,a.appointment_date,a.status FROM Appointments a JOIN Patients p ON a.patient_id=p.patient_id JOIN Doctors d ON a.doctor_id=d.doctor_id;
SELECT status,COUNT(*) AS total FROM Appointments GROUP BY status;
SELECT doctor_id,AVG(fee) AS average_fee FROM Appointments GROUP BY doctor_id;
